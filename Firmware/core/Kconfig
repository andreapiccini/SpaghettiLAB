module = SPAGHETTI_RELAY
module-str = spaghetti_relay
source "subsys/logging/Kconfig.template.log_config"

config SPAGHETTI_MAX_MODULES
	int "Maximum number of simultaneous runtime Modules"
	range 1 255
	default 8
	help
	  Fixed capacity of the Module Manager slot pool. Multiple slots may
	  reference the same physical Port when their endpoints differ.

config SPAGHETTI_INA219_MAX_INSTANCES
	int "Maximum number of simultaneous INA219 instances"
	range 1 SPAGHETTI_MAX_MODULES
	default 4
	help
	  Number of typed INA219 contexts reserved in the driver-owned memory
	  slab. Allocation is non-blocking and does not use the heap.

config SPAGHETTI_RELAY_MAX_INSTANCES
	int "Maximum number of simultaneous Relay instances"
	range 1 SPAGHETTI_MAX_MODULES
	default 4
	help
	  Number of typed Relay contexts reserved in the driver-owned memory slab.
	  Allocation is non-blocking and does not use the heap.

config SPAGHETTI_DATA_LOGGER
	bool "Enable the electrical Data logger consumer"
	default y
	help
	  Start one bounded thread that drains the electrical logger subscriber
	  and writes normalized samples through Zephyr logging.

config SPAGHETTI_DATA_LOGGER_STACK_SIZE
	int "Electrical Data logger stack size"
	depends on SPAGHETTI_DATA_LOGGER
	range 768 4096
	default 1024
	help
	  Static stack bytes reserved for the electrical logger consumer.

config SPAGHETTI_DATA_LOGGER_PRIORITY
	int "Electrical Data logger thread priority"
	depends on SPAGHETTI_DATA_LOGGER
	range 0 15
	default 5
	help
	  Cooperative-independent preemptive priority used by the logger thread.

config SPAGHETTI_RUNTIME_STACK_SIZE
	int "Runtime sampling thread stack size"
	range 1024 4096
	default 1536
	help
	  Static stack bytes reserved for the Runtime sampling worker.

config SPAGHETTI_RUNTIME_PRIORITY
	int "Runtime sampling thread priority"
	range 0 14
	default 4
	help
	  Preemptive priority used by the Runtime sampling worker. The default is
	  one level above the Data logger so acquisition is not delayed by logging.

config SPAGHETTI_RUNTIME_RULE_STACK_SIZE
	int "Runtime threshold-rule thread stack size"
	range 1024 4096
	default 1536
	help
	  Static stack bytes reserved for consuming electrical Data and applying
	  the single Runtime V1 threshold rule.

config SPAGHETTI_RUNTIME_RULE_PRIORITY
	int "Runtime threshold-rule thread priority"
	range 0 14
	default 4
	help
	  Preemptive priority used by the Runtime threshold-rule worker.

config SPAGHETTI_RUNTIME_STOP_TIMEOUT_MS
	int "Runtime stop timeout in milliseconds"
	range 10 5000
	default 1000
	help
	  Maximum time Config waits for an active sampling operation to finish
	  before it refuses to replace live Modules.

config SPAGHETTI_MQTT_QUEUE_DEPTH
	int "MQTT outbound publication queue depth"
	range 1 16
	default 4
	help
	  Fixed number of copied publications retained while the network or broker
	  is unavailable. A full queue drops the newest publication.

config SPAGHETTI_MQTT_WORKER_STACK_SIZE
	int "MQTT network worker stack size"
	range 2048 8192
	default 4096
	help
	  Static stack bytes reserved for DNS, socket, and MQTT client work.

config SPAGHETTI_MQTT_ADAPTER_STACK_SIZE
	int "MQTT Data adapter stack size"
	range 1024 4096
	default 1536
	help
	  Static stack bytes reserved for receiving zbus electrical samples and
	  formatting bounded JSON publications.

config SPAGHETTI_MQTT_PRIORITY
	int "MQTT worker and adapter priority"
	range 0 15
	default 5
	help
	  Preemptive priority used by both MQTT-owned threads.

config SPAGHETTI_MQTT_STOP_TIMEOUT_MS
	int "MQTT stop timeout in milliseconds"
	range 100 10000
	default 2000
	help
	  Maximum time Config waits for the worker to stop before rejecting a new
	  MQTT configuration.

config SPAGHETTI_WIFI_PROFILE_MAX_COUNT
	int "Maximum number of persistent Wi-Fi profiles"
	range 1 8
	default 4
	help
	  Fixed number of encrypted profile slots. The service uses no heap, so a
	  larger value reserves more static RAM and persistent records.

config SPAGHETTI_WIFI_PROFILE_AUTO_CONNECT
	bool "Automatically connect to a known Wi-Fi network"
	default y
	help
	  Scan after boot and disconnection. A visible preferred profile is tried
	  first; other visible profiles are tried by descending signal strength.

config SPAGHETTI_WIFI_PROFILE_WORKER_STACK_SIZE
	int "Wi-Fi profile worker stack size"
	depends on SPAGHETTI_WIFI_PROFILE_AUTO_CONNECT
	range 2048 8192
	default 4096

config SPAGHETTI_WIFI_PROFILE_WORKER_PRIORITY
	int "Wi-Fi profile worker priority"
	depends on SPAGHETTI_WIFI_PROFILE_AUTO_CONNECT
	range 0 15
	default 5

config SPAGHETTI_WIFI_SCAN_TIMEOUT_SECONDS
	int "Wi-Fi scan timeout in seconds"
	depends on SPAGHETTI_WIFI_PROFILE_AUTO_CONNECT
	range 1 60
	default 15

config SPAGHETTI_WIFI_CONNECT_TIMEOUT_SECONDS
	int "Wi-Fi connection timeout in seconds"
	depends on SPAGHETTI_WIFI_PROFILE_AUTO_CONNECT
	range 1 120
	default 30

config SPAGHETTI_WIFI_DISCONNECT_TIMEOUT_SECONDS
	int "Wi-Fi disconnection timeout in seconds"
	depends on SPAGHETTI_WIFI_PROFILE_AUTO_CONNECT
	range 1 30
	default 5

config SPAGHETTI_WIFI_RETRY_SECONDS
	int "Wi-Fi reselection interval in seconds"
	depends on SPAGHETTI_WIFI_PROFILE_AUTO_CONNECT
	range 1 3600
	default 30

config SPAGHETTI_WIFI_PASSWORD_INPUT_TIMEOUT_SECONDS
	int "Hidden Wi-Fi password prompt timeout in seconds"
	range 10 300
	default 60

source "Kconfig.zephyr"
