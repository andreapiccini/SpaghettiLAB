#include <example_module.h>

#include <errno.h>
#include <stdbool.h>
#include <stddef.h>
#include <stdint.h>
#include <string.h>

#include <zephyr/device.h>
#include <zephyr/drivers/i2c.h>
#include <zephyr/kernel.h>
#include <zephyr/logging/log.h>

#include <spaghetti/module.h>
#include <spaghetti/module_driver.h>
#include <spaghetti/port.h>

LOG_MODULE_REGISTER(spaghetti_example_module,
			    CONFIG_SPAGHETTI_EXAMPLE_MODULE_LOG_LEVEL);

#define EXAMPLE_I2C_ADDRESS_MIN 0x08U
#define EXAMPLE_I2C_ADDRESS_MAX 0x77U

struct example_context {
	const struct device *i2c; /* Borrowed from Port; firmware lifetime. */
	struct spaghetti_example_module_config config; /* Owned copy. */
	bool initialized;
};

K_MEM_SLAB_DEFINE(example_context_slab, sizeof(struct example_context),
		  CONFIG_SPAGHETTI_EXAMPLE_MODULE_MAX_INSTANCES,
		  __alignof__(struct example_context));

static int example_validate_config(const void *config, size_t config_size)
{
	struct spaghetti_example_module_config candidate;

	if ((config == NULL) || (config_size != sizeof(candidate))) {
		return -EINVAL;
	}

	memcpy(&candidate, config, sizeof(candidate));
	if ((candidate.i2c_address < EXAMPLE_I2C_ADDRESS_MIN) ||
	    (candidate.i2c_address > EXAMPLE_I2C_ADDRESS_MAX)) {
		return -EINVAL;
	}

	return 0;
}

static int example_describe_endpoint(
	const void *config, size_t config_size,
	struct spaghetti_module_endpoint *out)
{
	struct spaghetti_example_module_config candidate;
	int err;

	if (out == NULL) {
		return -EINVAL;
	}

	err = example_validate_config(config, config_size);
	if (err < 0) {
		return err;
	}
	memcpy(&candidate, config, sizeof(candidate));

	const struct spaghetti_module_endpoint endpoint = {
		.kind = SPAGHETTI_ENDPOINT_I2C_ADDRESS,
		.value = candidate.i2c_address,
	};

	*out = endpoint;
	return 0;
}

static void example_free_context(struct example_context *context)
{
	memset(context, 0, sizeof(*context));
	k_mem_slab_free(&example_context_slab, context);
}

static int example_init(struct spaghetti_module *module, const void *config,
			size_t config_size)
{
	struct spaghetti_example_module_config candidate;
	struct example_context *context;
	void *context_block;
	int err;

	if ((module == NULL) || (module->port == NULL) ||
	    (module->context != NULL)) {
		return -EINVAL;
	}

	err = example_validate_config(config, config_size);
	if (err < 0) {
		return err;
	}
	memcpy(&candidate, config, sizeof(candidate));

	err = k_mem_slab_alloc(&example_context_slab, &context_block, K_NO_WAIT);
	if (err < 0) {
		return -ENOMEM;
	}

	context = context_block;
	memset(context, 0, sizeof(*context));
	context->i2c = spaghetti_port_i2c_device(module->port);
	if (context->i2c == NULL) {
		err = -ENOTSUP;
		goto free_context;
	}
	if (!device_is_ready(context->i2c)) {
		err = -ENODEV;
		goto free_context;
	}

	context->config = candidate;
	/* Perform bounded device initialization here. */
	context->initialized = true;
	module->context = context;
	return 0;

free_context:
	example_free_context(context);
	return err;
}

static int example_read(struct spaghetti_module *module,
			struct spaghetti_sample *out)
{
	struct example_context *context;
	struct spaghetti_sample candidate = {0};

	if ((module == NULL) || (out == NULL) ||
	    (module->state != SPAGHETTI_MODULE_READY) ||
	    (module->context == NULL)) {
		return -EINVAL;
	}

	context = module->context;
	if (!context->initialized) {
		return -EACCES;
	}

	/*
	 * Perform bounded I2C here, convert to the current electrical sample,
	 * and write only candidate until every operation succeeds.
	 * Task 300 moves shared-controller transactions behind Port; task 310
	 * replaces this concrete sample with a schema-described payload.
	 */
	*out = candidate;
	return 0;
}

static int example_deinit(struct spaghetti_module *module)
{
	struct example_context *context;

	if ((module == NULL) || (module->context == NULL)) {
		return -EINVAL;
	}

	context = module->context;
	/* Put only this endpoint in its documented safe state here. */
	module->context = NULL;
	example_free_context(context);
	return 0;
}

static const struct spaghetti_module_driver_ops example_ops = {
	.validate_config = example_validate_config,
	.describe_endpoint = example_describe_endpoint,
	.init = example_init,
	.read = example_read,
	.command = NULL,
	.deinit = example_deinit,
};

const struct spaghetti_module_driver spaghetti_example_module_driver = {
	.type_id = "example",
	.required_capabilities = SPAGHETTI_PORT_CAP_I2C,
	.ops = &example_ops,
};
