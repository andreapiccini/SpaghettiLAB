# Copy this file to .env to override the defaults baked into compose.yaml.
# Node-RED starts with sensible defaults even without a .env file.

# Host port Node-RED's editor/API is published on (loopback only).
NODE_RED_PORT=1880

# Timezone used inside the container (affects timestamps and scheduling nodes).
TZ=Europe/Rome

# Which theme/ subfolder to mount as the Spaghetti LAB branding layer.
# "safe" (default) uses only documented editorTheme options and colors.
# Other tiers (e.g. a future "deep" theme) may be added later; see
# theme/README.md.
NODE_RED_THEME=safe
